---
/**
 * Branchepagina's: /kapper, /bakker en /snackbar.
 * De teksten staan in src/data/branches.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import AccentTitel from '../components/AccentTitel.astro';
import BrancheCards from '../components/BrancheCards.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import StandMockup from '../components/StandMockup.astro';
import Testimonials from '../components/Testimonials.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { branches, type Branche } from '../data/branches';
import { bedrijf, prijzen } from '../data/bedrijf';
import { productById } from '../data/producten';
import { testimonials } from '../data/testimonials';
import { formatPrijs, absoluteUrl } from '../lib/format';
import { dienst } from '../lib/schema';
import { seo } from '../data/seo';

export function getStaticPaths() {
  return branches.map((branche) => ({ params: { branche: branche.slug }, props: { branche } }));
}

interface Props {
  branche: Branche;
}

const { branche } = Astro.props;
const pad = `/${branche.slug}` as const;
const kruimels = [{ naam: branche.naam, href: pad }];
const bericht = `Hoi Tipero! Ik heb een ${branche.zaak} en wil graag meer weten over een NFC-standaard.`;
const toonTestimonial = testimonials.length > 0 || bedrijf.toonPlaceholders;

const schema = [
  dienst({
    url: absoluteUrl(pad),
    naam: seo[pad].titel.replace(/ \| Tipero$/, ''),
    omschrijving: seo[pad].omschrijving,
    doelgroep: branche.naam,
  }),
];
---

<BaseLayout pad={pad} kruimels={kruimels} schema={schema}>
  <PageHero
    eyebrow={branche.hero.eyebrow}
    titel={branche.hero.titel}
    accent={branche.hero.accent}
    intro={branche.hero.intro}
    kruimels={kruimels}
  >
    <div class="btn-row" slot="acties">
      <WhatsAppButton bericht={bericht} />
      <a class="btn btn--outline" href="/prijzen">Vanaf {formatPrijs(prijzen.standaard)}</a>
    </div>
    <div class="duo" slot="aside">
      {
        branche.standen.map((stand, i) => (
          <div class:list={['duo__stand', `duo__stand--${i + 1}`]}>
            <StandMockup
              soort={stand.soort}
              regels={stand.regels}
              accentRegel={stand.accentRegel}
              subtekst={stand.subtekst}
            />
          </div>
        ))
      }
    </div>
  </PageHero>

  <!-- Waarom reviews -->
  <section class="section" aria-labelledby="waarom-titel">
    <div class="container waarom">
      <div>
        <p class="eyebrow">Waarom reviews</p>
        <AccentTitel tekst={branche.waarom.titel} id="waarom-titel" />
      </div>
      <div class="waarom__tekst">
        {branche.waarom.alineas.map((a) => <p>{a}</p>)}
      </div>
    </div>
  </section>

  <!-- Toepassingen -->
  <section class="section section--grey" aria-labelledby="toepassingen-titel">
    <div class="container">
      <SectionHeader
        eyebrow="Toepassingen"
        titel={`Zo gebruik je Tipero in je ${branche.zaak}`}
        intro="Drie standen, elk met een eigen doel. Kies er één of combineer ze."
        id="toepassingen-titel"
      />
      <ul class="toepassingen" role="list">
        {
          branche.toepassingen.map((t) => {
            const product = productById(t.product);
            return (
              <li class="toepassing">
                <div class="toepassing__kop">
                  <span class="toepassing__icoon">
                    <Icon name={product.icoon} size={22} />
                  </span>
                  <span class="toepassing__product">{product.naam}</span>
                </div>
                <h3>{t.titel}</h3>
                <p>{t.tekst}</p>
                <a class="link-arrow" href={`/producten#${product.id}`}>
                  Bekijk de {product.naam.toLowerCase()}
                  <Icon name="arrow-right" />
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <!-- Plekken en voorbeeldteksten -->
  <section class="section" aria-labelledby="plekken-titel">
    <div class="container plekken">
      <div>
        <SectionHeader eyebrow="Tips" titel="Waar zet je de stand neer?" id="plekken-titel" />
        <ol class="plekken__lijst">
          {
            branche.plekken.map((p, i) => (
              <li>
                <span class="plekken__nr" aria-hidden="true">
                  {i + 1}
                </span>
                <div>
                  <h3>{p.titel}</h3>
                  <p>{p.tekst}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <aside class="voorbeelden on-dark" aria-labelledby="voorbeelden-titel">
        <h3 id="voorbeelden-titel">Voorbeeldteksten voor op je stand</h3>
        <ul>
          {branche.voorbeeldteksten.map((t) => <li>“{t}”</li>)}
        </ul>
        <p class="voorbeelden__regels">
          <Icon name="shield" size={18} />
          <span>
            Elke tekst spreekt iedere klant aan, zonder beloning. Zo blijf je binnen{' '}
            <a href="/veelgestelde-vragen#google">de regels van Google</a>.
          </span>
        </p>
      </aside>
    </div>
  </section>

  {
    toonTestimonial && (
      <section class="section section--grey" aria-labelledby="ervaring-titel">
        <div class="container container--narrow">
          <SectionHeader eyebrow="Ervaringen" titel={`Wat ${branche.meervoud} zeggen`} id="ervaring-titel" center />
          <Testimonials aantalPlaceholders={1} placeholderTekst={branche.testimonialPlaceholder} />
        </div>
      </section>
    )
  }

  <!-- Vragen -->
  <section class:list={['section', { 'section--grey': !toonTestimonial }]} aria-labelledby="vragen-titel">
    <div class="container container--narrow">
      <SectionHeader eyebrow="Vragen" titel={`Vragen van ${branche.meervoud}`} id="vragen-titel" center />
      <FaqList vragen={branche.vragen.map((v) => ({ vraag: v.vraag, antwoord: [v.antwoord] }))} />
      <p class="meer-vragen">
        <a class="link-arrow" href="/veelgestelde-vragen">
          Alle veelgestelde vragen
          <Icon name="arrow-right" />
        </a>
      </p>
    </div>
  </section>

  <!-- Lokaal -->
  <section class="section section--ink on-dark" aria-labelledby="lokaal-titel">
    <div class="container">
      <div class="lokaal">
        <div>
          <p class="eyebrow">Werkgebied</p>
          <h2 id="lokaal-titel">{branche.lokaal.titel}</h2>
        </div>
        <div class="lokaal__tekst">
          <p>{branche.lokaal.tekst}</p>
          <a class="link-arrow" href="/werkgebied">
            Bekijk het werkgebied
            <Icon name="arrow-right" />
          </a>
        </div>
      </div>
      <h3 class="andere__titel">Ook voor andere zaken</h3>
      <BrancheCards behalve={branche.slug} />
    </div>
  </section>

  <CtaBand bericht={bericht} />
</BaseLayout>

<style>
  .duo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: 0;
    max-width: 26rem;
    margin-inline: auto;
  }

  .duo__stand :global(svg) {
    filter: drop-shadow(0 20px 30px rgb(0 0 0 / 0.35));
  }

  .duo__stand--1 {
    transform: rotate(-4deg);
    z-index: 1;
  }

  .duo__stand--2 {
    transform: rotate(5deg) translate(-12%, 6%);
  }

  .waarom {
    display: grid;
    gap: 1.5rem 5rem;
  }

  .waarom :global(h2) {
    margin-top: 1rem;
  }

  .waarom__tekst {
    display: grid;
    gap: 1rem;
    font-size: var(--fs-lead);
    color: var(--text-muted);
    align-content: start;
  }

  @media (min-width: 900px) {
    .waarom {
      grid-template-columns: 1fr 1fr;
    }

    .waarom__tekst {
      padding-top: 2.4rem;
    }
  }

  .toepassingen {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 900px) {
    .toepassingen {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  .toepassing {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    border-radius: var(--radius);
    background: var(--white);
    border: 1px solid var(--grey-200);
  }

  .toepassing__kop {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .toepassing__icoon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--yellow);
  }

  .toepassing__product {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .toepassing p {
    color: var(--text-muted);
  }

  .toepassing .link-arrow {
    margin-top: auto;
    align-self: flex-start;
  }

  .plekken {
    display: grid;
    gap: 3rem 5rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .plekken {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }
  }

  .plekken__lijst {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .plekken__lijst li {
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: 1rem;
  }

  .plekken__nr {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--yellow);
    font-weight: 700;
  }

  .plekken__lijst p {
    margin-top: 0.25rem;
    color: var(--text-muted);
  }

  .voorbeelden {
    padding: clamp(1.75rem, 3vw, 2.5rem);
    border-radius: var(--radius-lg);
    background: var(--ink);
  }

  .voorbeelden h3 {
    font-size: 1.25rem;
  }

  .voorbeelden ul {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
    display: grid;
    gap: 0.75rem;
  }

  .voorbeelden li {
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius-sm);
    background: var(--ink-2);
    border-left: 4px solid var(--yellow);
    font-weight: 600;
  }

  .voorbeelden__regels {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.5rem;
    font-size: 0.875rem;
    color: var(--text-on-dark-muted);
  }

  .voorbeelden__regels :global(svg) {
    flex: none;
    color: var(--yellow);
    margin-top: 0.1rem;
  }

  .voorbeelden__regels a {
    color: var(--white);
  }

  .meer-vragen {
    margin-top: 2.5rem;
    text-align: center;
  }

  .lokaal {
    display: grid;
    gap: 1.5rem 5rem;
  }

  .lokaal h2 {
    margin-top: 1rem;
  }

  .lokaal__tekst {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    font-size: var(--fs-lead);
    color: var(--text-on-dark-muted);
  }

  .lokaal__tekst .link-arrow {
    color: var(--white);
    font-size: 1rem;
  }

  @media (min-width: 900px) {
    .lokaal {
      grid-template-columns: 1fr 1fr;
    }

    .lokaal__tekst {
      padding-top: 2.4rem;
    }
  }

  .andere__titel {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    margin-bottom: 1.5rem;
  }
</style>
