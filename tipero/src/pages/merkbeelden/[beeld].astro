---
/**
 * Sjablonen voor OG-afbeeldingen, icons en productfoto's.
 * Deze pagina's bestaan ALLEEN tijdens `npm run dev` en worden niet gepubliceerd.
 * Ze worden omgezet naar PNG met `npm run afbeeldingen` (zie scripts/maak-afbeeldingen.mjs).
 */
import { Font } from 'astro:assets';
import '../../styles/global.css';
import AccentTitel from '../../components/AccentTitel.astro';
import HeroTap from '../../components/HeroTap.astro';
import Logo from '../../components/Logo.astro';
import Mark from '../../components/Mark.astro';
import StandMockup from '../../components/StandMockup.astro';
import WerkgebiedKaart from '../../components/WerkgebiedKaart.astro';
import beelden from '../../../scripts/merkbeelden.json';
import { branches } from '../../data/branches';
import { prijzen } from '../../data/bedrijf';
import { formatPrijs } from '../../lib/format';

export function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  return beelden.map((b) => ({ params: { beeld: b.id }, props: { beeld: b } }));
}

interface Props {
  beeld: (typeof beelden)[number];
}

const { beeld } = Astro.props;
const { id, breedte, hoogte } = beeld;
const branche = branches.find((b) => id === `og-${b.slug}`);

const og: Record<string, { eyebrow: string; titel: string; accent?: string }> = {
  'og-tipero': { eyebrow: 'NFC-standaards voor lokale zaken', titel: 'Meer Google-reviews, zonder erom te vragen', accent: 'Google-reviews' },
  'og-producten': { eyebrow: 'Producten', titel: 'Eén stand voor reviews, menu en socials', accent: 'reviews, menu en socials' },
  'og-hoe-het-werkt': { eyebrow: 'Hoe het werkt', titel: 'Ik kom langs, stel alles in en test het ter plekke', accent: 'ter plekke' },
  'og-prijzen': { eyebrow: 'Prijzen', titel: `Vanaf ${formatPrijs(prijzen.standaard)}, alles inbegrepen`, accent: formatPrijs(prijzen.standaard) },
  'og-werkgebied': { eyebrow: 'Werkgebied', titel: 'Lekkerkerk, de Krimpenerwaard en omgeving', accent: 'Lekkerkerk' },
  'og-veelgestelde-vragen': { eyebrow: 'Veelgestelde vragen', titel: 'Alles over de NFC review standaard', accent: 'NFC' },
};
const kaart = branche
  ? { eyebrow: branche.hero.eyebrow, titel: branche.hero.titel, accent: branche.hero.accent }
  : og[id];
const isOg = id.startsWith('og-');
const product = id.startsWith('product-') ? id.replace('product-', '') : null;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{id}</title>
    <Font cssVariable="--font-poppins" preload />
    <style set:html={`html,body{width:${breedte}px;height:${hoogte}px;overflow:hidden;margin:0}`}></style>
  </head>
  <body class:list={{ transparant: beeld.transparant }}>
    {
      isOg && kaart && (
        <div class="og on-dark">
          <div class="og__tekst">
            <Logo variant="wit" label="" class="og__logo" />
            <div>
              <p class="eyebrow">{kaart.eyebrow}</p>
              <AccentTitel as="h1" tekst={kaart.titel} accent={kaart.accent} class="og__titel" />
            </div>
            <p class="og__voet">
              <Mark size={22} />
              tipero.nl · Lekkerkerk en omgeving
            </p>
          </div>
          <div class:list={['og__beeld', { 'og__beeld--schijf': !['og-tipero', 'og-hoe-het-werkt', 'og-werkgebied'].includes(id) }]}>
            {(id === 'og-tipero' || id === 'og-hoe-het-werkt') && <HeroTap />}
            {id === 'og-producten' && (
              <div class="og__trio">
                <StandMockup soort="menu" label="" />
                <StandMockup soort="review" label="" />
                <StandMockup soort="socials" label="" />
              </div>
            )}
            {id === 'og-prijzen' && (
              <div class="og__duo">
                <StandMockup soort="review" label="" />
                <StandMockup soort="review" ontwerp="huisstijl" label="" />
              </div>
            )}
            {branche && (
              <div class="og__duo">
                {branche.standen.map((s) => (
                  <StandMockup soort={s.soort} regels={s.regels} accentRegel={s.accentRegel} subtekst={s.subtekst} label="" />
                ))}
              </div>
            )}
            {id === 'og-werkgebied' && (
              <div class="og__kaart">
                <WerkgebiedKaart />
              </div>
            )}
            {id === 'og-veelgestelde-vragen' && (
              <div class="og__een">
                <StandMockup soort="review" label="" />
              </div>
            )}
          </div>
        </div>
      )
    }

    {
      id === 'logo-512' && (
        <div class="vlak vlak--wit">
          <Logo label="" class="vlak__logo" />
        </div>
      )
    }

    {
      (id === 'apple-touch-icon' || id === 'favicon-32') && (
        <div class:list={['vlak', 'vlak--ink', { 'vlak--rond': id === 'favicon-32' }]}>
          <Mark size="68%" />
        </div>
      )
    }

    {
      product && (
        <div class="vlak vlak--product">
          {product === 'set' ? (
            <div class="product-duo">
              <StandMockup soort="review" label="" />
              <StandMockup soort="menu" label="" />
            </div>
          ) : (
            <StandMockup soort={product as 'review' | 'menu' | 'socials'} label="" class="product-een" />
          )}
        </div>
      )
    }
  </body>
</html>

<style>
  body.transparant {
    background: transparent;
  }

  .og {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    width: 1200px;
    height: 630px;
    padding: 56px 40px 52px 64px;
    background: var(--ink);
    overflow: hidden;
  }

  .og__tekst {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .og__tekst :global(.og__logo) {
    width: 150px;
  }

  .og__tekst .eyebrow {
    font-size: 17px;
    margin-bottom: 20px;
  }

  .og__tekst :global(.og__titel) {
    font-size: 60px;
    line-height: 1.04;
    max-width: 15ch;
  }

  .og__voet {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 20px;
    font-weight: 600;
    color: var(--text-on-dark-muted);
  }

  .og__beeld {
    display: grid;
    place-items: center;
    margin: -56px -40px -52px 0;
  }

  .og__beeld--schijf {
    background: radial-gradient(circle at 50% 52%, var(--yellow) 0 37%, transparent 37.3%);
  }

  .og__beeld :global(.hero-tap) {
    width: 560px;
  }

  .og__trio,
  .og__duo {
    display: flex;
    align-items: flex-end;
  }

  .og__trio :global(svg) {
    width: 170px;
    filter: drop-shadow(0 18px 24px rgb(0 0 0 / 0.35));
  }

  .og__trio :global(svg:nth-child(1)) {
    transform: rotate(-8deg) translateX(30px);
  }

  .og__trio :global(svg:nth-child(2)) {
    z-index: 1;
    width: 200px;
  }

  .og__trio :global(svg:nth-child(3)) {
    transform: rotate(8deg) translateX(-30px);
  }

  .og__duo :global(svg) {
    width: 215px;
    filter: drop-shadow(0 18px 24px rgb(0 0 0 / 0.35));
  }

  .og__duo :global(svg:nth-child(1)) {
    transform: rotate(-4deg);
    z-index: 1;
  }

  .og__duo :global(svg:nth-child(2)) {
    transform: rotate(5deg) translate(-28px, 14px);
  }

  .og__kaart {
    width: 540px;
  }

  .og__kaart :global(figcaption) {
    display: none;
  }

  .og__een :global(svg) {
    width: 250px;
    filter: drop-shadow(0 18px 24px rgb(0 0 0 / 0.35));
  }

  .vlak {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
  }

  .vlak--wit {
    background: var(--white);
  }

  .vlak--wit :global(.vlak__logo) {
    width: 78%;
  }

  .vlak--ink {
    background: var(--ink);
  }

  .vlak--rond {
    border-radius: 7px;
  }

  .vlak--product {
    background: radial-gradient(circle at 50% 54%, var(--yellow) 0 34%, transparent 34.3%), var(--grey-50);
  }

  .vlak--product :global(.product-een) {
    width: 46%;
  }

  .product-duo {
    display: flex;
    gap: 24px;
    width: 76%;
  }

  .product-duo :global(svg) {
    width: 50%;
  }
</style>
