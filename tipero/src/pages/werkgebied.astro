---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import RegioBeeld from '../components/RegioBeeld.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Steps from '../components/Steps.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { stappenKort } from '../data/stappen';
import { werkgebied } from '../data/werkgebied';

const kruimels = [{ naam: 'Werkgebied', href: '/werkgebied' }];
---

<BaseLayout pad="/werkgebied" kruimels={kruimels}>
  <PageHero
    eyebrow="Werkgebied"
    titel={`Tipero komt langs in de ${werkgebied.naam}`}
    accent={werkgebied.naam}
    intro="Tipero komt naar je toe. Ik kom langs bij ondernemers in Rotterdam en omgeving, stel de stand in en test hem samen met je."
    kruimels={kruimels}
  >
    <div class="btn-row" slot="acties">
      <WhatsAppButton />
      <a class="btn btn--outline" href="/prijzen">Bekijk de prijzen</a>
    </div>
    <RegioBeeld slot="aside" />
  </PageHero>

  <section class="section" aria-labelledby="langskomen-titel">
    <div class="container langskomen">
      <div>
        <p class="eyebrow">Persoonlijk</p>
        <h2 id="langskomen-titel">Waarom ik langskom</h2>
      </div>
      <div class="langskomen__tekst">
        <p>
          Een NFC-standaard bestel je bij Tipero niet online en krijg je niet per post. Ik kom naar je zaak, zoek de juiste
          link voor je op en test de stand ter plekke met een iPhone en een Android.
        </p>
        <p>
          Dat werkt het beste als je in de buurt zit. Daarom richt Tipero zich op de {werkgebied.naam}. Zo blijf ik ook na
          de levering makkelijk bereikbaar: een appje is genoeg.
        </p>
        <p>
          We spreken een moment af dat jou uitkomt: voor openingstijd, op een rustig moment of tussen twee klanten door.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--grey" aria-labelledby="stappen-titel">
    <div class="container">
      <SectionHeader eyebrow="Zo gaat het" titel="Van berichtje tot stand op je toonbank" id="stappen-titel" />
      <Steps stappen={stappenKort} />
      <p class="meer">
        <a class="link-arrow" href="/hoe-het-werkt">
          Lees hoe het precies werkt
          <Icon name="arrow-right" />
        </a>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="buiten-titel">
    <div class="container">
      <div class="buiten">
        <span class="buiten__icoon"><Icon name="pin" size={24} /></span>
        <div>
          <h2 id="buiten-titel">Net buiten de regio?</h2>
          <p>Vraag het gerust. Vaak is er wel iets te regelen.</p>
        </div>
        <WhatsAppButton variant="ink" tekst="Vraag het via WhatsApp" bericht="Hoi Tipero! Kom je ook langs in mijn plaats?" />
      </div>
    </div>
  </section>

  <CtaBand titel="Zit je in de regio Rotterdam?" />
</BaseLayout>

<style>
  .langskomen {
    display: grid;
    gap: 1.5rem 5rem;
  }

  .langskomen h2 {
    margin-top: 1rem;
  }

  .langskomen__tekst {
    display: grid;
    gap: 1rem;
    color: var(--text-muted);
    font-size: var(--fs-lead);
  }

  @media (min-width: 900px) {
    .langskomen {
      grid-template-columns: 1fr 1fr;
    }

    .langskomen__tekst {
      padding-top: 2.4rem;
    }
  }

  .meer {
    margin-top: 2.5rem;
  }

  .buiten {
    display: grid;
    gap: 1.25rem;
    align-items: center;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: var(--radius-lg);
    background: var(--yellow-soft);
  }

  .buiten h2 {
    font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem);
  }

  .buiten p {
    margin-top: 0.35rem;
    color: var(--text-muted);
  }

  .buiten__icoon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--yellow);
  }

  @media (min-width: 800px) {
    .buiten {
      grid-template-columns: auto 1fr auto;
      gap: 1.5rem;
    }
  }
</style>
