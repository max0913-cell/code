---
/**
 * Header met hoofdmenu. Het mobiele menu gebruikt de native
 * popover-API: werkt met toetsenbord en Escape, zonder JavaScript.
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { hoofdmenu } from '../data/navigatie';

interface Props {
  actief: string;
}

const { actief } = Astro.props;
---

<header class="site-header on-dark">
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo" aria-label="Tipero, naar de homepage">
      <Logo variant="wit" label="" />
    </a>

    <nav class="site-nav" aria-label="Hoofdmenu">
      <button class="site-nav__toggle" type="button" popovertarget="hoofdmenu" aria-controls="hoofdmenu">
        <Icon name="menu" size={22} />
        <span>Menu</span>
      </button>

      <div id="hoofdmenu" class="site-nav__panel" popover>
        <div class="site-nav__top">
          <span class="site-nav__label">Menu</span>
          <button
            class="site-nav__close"
            type="button"
            popovertarget="hoofdmenu"
            popovertargetaction="hide"
            aria-label="Menu sluiten"
          >
            <Icon name="close" size={22} />
          </button>
        </div>
        <ul class="site-nav__list">
          {
            hoofdmenu.map((item) => (
              <li>
                <a href={item.href} aria-current={actief === item.href ? 'page' : undefined}>
                  {item.tekst}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="btn btn--yellow site-nav__cta" href="/contact" aria-current={actief === '/contact' ? 'page' : undefined}>
          Vraag een stand aan
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--ink);
    position: relative;
    z-index: 10;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.75rem;
  }

  .site-header__logo {
    display: block;
    padding-block: 0.5rem;
    border-radius: 8px;
  }

  .site-header__logo :global(svg) {
    width: 6.5rem;
  }

  .site-nav__toggle,
  .site-nav__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    min-width: 2.75rem;
    padding: 0.5rem 1rem;
    border: 2px solid var(--ink-line);
    border-radius: 999px;
    background: transparent;
    color: var(--white);
    font-weight: 600;
  }

  .site-nav__toggle:hover,
  .site-nav__close:hover {
    border-color: var(--yellow);
  }

  .site-nav__close {
    padding: 0.5rem;
  }

  /* ── Mobiel: menu als popover-paneel ── */
  .site-nav__panel {
    inset: 0 0 auto 0;
    width: 100%;
    max-width: 100%;
    max-height: 100dvh;
    margin: 0;
    padding: 0.9rem var(--gutter) 2rem;
    border: 0;
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    background: var(--ink);
    color: var(--white);
    box-shadow: 0 30px 60px rgb(0 0 0 / 0.4);
    overflow-y: auto;
    --focus-ring: var(--yellow);
  }

  .site-nav__panel::backdrop {
    background: rgb(7 8 15 / 0.6);
  }

  .site-nav__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3rem;
    margin-bottom: 0.5rem;
  }

  .site-nav__label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-on-dark-muted);
  }

  .site-nav__list {
    list-style: none;
    padding: 0;
  }

  .site-nav__list a {
    display: flex;
    align-items: center;
    min-height: 3.25rem;
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    border-bottom: 1px solid var(--ink-line);
  }

  .site-nav__list a[aria-current='page'] {
    color: var(--yellow);
  }

  .site-nav__cta {
    width: 100%;
    margin-top: 1.5rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-nav__panel:popover-open {
      animation: menu-in 0.22s ease-out;
    }
  }

  @keyframes menu-in {
    from {
      transform: translateY(-12px);
      opacity: 0;
    }
  }

  /* ── Desktop: gewoon een horizontaal menu ── */
  @media (min-width: 1040px) {
    .site-nav__toggle,
    .site-nav__top {
      display: none;
    }

    .site-nav__panel {
      display: flex;
      align-items: center;
      gap: 2rem;
      position: static;
      inset: auto;
      width: auto;
      max-height: none;
      padding: 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
      overflow: visible;
    }

    .site-nav__list {
      display: flex;
      gap: 1.6rem;
    }

    .site-nav__list a {
      min-height: 2.75rem;
      font-size: 0.9375rem;
      font-weight: 500;
      border-bottom: 2px solid transparent;
    }

    .site-nav__list a:hover {
      border-bottom-color: var(--ink-line);
    }

    .site-nav__list a[aria-current='page'] {
      color: var(--white);
      border-bottom-color: var(--yellow);
    }

    .site-nav__cta {
      width: auto;
      margin: 0;
      min-height: 2.875rem;
      padding: 0.6rem 1.25rem;
      font-size: 0.9375rem;
    }
  }
</style>
