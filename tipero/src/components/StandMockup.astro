---
/**
 * Voorbeeld van een Tipero-stand (vooraanzicht), als SVG.
 * - ontwerp "standaard": Tipero zwart/geel
 * - ontwerp "huisstijl": wit met eigen accentkleur en plek voor een logo
 */
import QrCode from './QrCode.astro';
import type { StandSoort } from '../lib/types';

interface Props {
  soort?: StandSoort;
  ontwerp?: 'standaard' | 'huisstijl';
  /** Regels van de grote tekst op de stand. */
  regels?: string[];
  /** Welke regel (index) het accent krijgt. */
  accentRegel?: number;
  /** Kleine tekst onder de kop. */
  subtekst?: string;
  /** Accentkleur voor het huisstijl-ontwerp (moet op wit minimaal 4.5:1 halen). */
  accent?: string;
  class?: string;
  /** Toegankelijke omschrijving; standaard automatisch. */
  label?: string;
}

const standaardTeksten: Record<StandSoort, { regels: string[]; accentRegel: number; subtekst: string }> = {
  review: { regels: ['Laat een', 'review', 'achter!'], accentRegel: 1, subtekst: 'Tik met je telefoon of scan' },
  menu: { regels: ['Bekijk', 'ons menu!'], accentRegel: 1, subtekst: 'Tik met je telefoon of scan' },
  socials: { regels: ['Volg ons op', 'Instagram!'], accentRegel: 1, subtekst: 'Tik met je telefoon of scan' },
};

const {
  soort = 'review',
  ontwerp = 'standaard',
  accent = '#0E6E5C',
  class: className,
} = Astro.props;

const basis = standaardTeksten[soort];
const regels = Astro.props.regels ?? basis.regels;
const accentRegel = Astro.props.accentRegel ?? basis.accentRegel;
const subtekst = Astro.props.subtekst ?? basis.subtekst;

const huisstijl = ontwerp === 'huisstijl';
const kleur = huisstijl
  ? {
      plaat: '#FFFFFF',
      rand: '#DCDDE6',
      achterkant: '#C9CAD6',
      kop: '#15172A',
      accent,
      sub: '#4A4D66',
      voet: '#D8D0BF',
      voetBoven: '#E8E2D5',
    }
  : {
      plaat: '#15172A',
      rand: '#2A2E4A',
      achterkant: '#07080F',
      kop: '#FFFFFF',
      accent: '#FFC61A',
      sub: '#B8BBD0',
      voet: '#2A2E4A',
      voetBoven: '#3A3F60',
    };

// Lettergrootte zo kiezen dat de langste regel past (Poppins Bold ≈ 0,6 em per teken).
const langste = Math.max(...regels.map((r) => r.length));
const fs = Math.min(30, Math.round((172 / (0.6 * langste)) * 10) / 10);
const regelHoogte = fs * 1.1;
const eersteRegel = 82 + fs * 0.8;
const subY = eersteRegel + (regels.length - 1) * regelHoogte + 24;

const naam = { review: 'reviewstand', menu: 'menustand', socials: 'socials-stand' }[soort];
const label =
  Astro.props.label ??
  `Voorbeeld van een ${naam}${huisstijl ? ' in eigen huisstijl' : ''} met de tekst "${regels.join(' ')}"`;

const sterX = [32, 47, 62, 77, 92];
---

<svg
  class:list={['stand', className]}
  viewBox="0 0 240 330"
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
  xmlns="http://www.w3.org/2000/svg"
>
  <ellipse cx="120" cy="320" rx="112" ry="6" fill="#15172A" opacity="0.12"></ellipse>
  <!-- plaat (achterkant voor diepte) -->
  <rect x="16" y="12" width="216" height="284" rx="18" fill={kleur.achterkant}></rect>
  <rect x="12" y="8" width="216" height="284" rx="18" fill={kleur.plaat} stroke={kleur.rand} stroke-width="1.5"></rect>

  <!-- linksboven: sterren, label of logo -->
  {
    huisstijl ? (
      <g>
        <circle cx="54" cy="48" r="22" fill="none" stroke={kleur.rand} stroke-width="1.5" stroke-dasharray="3 3" />
        <text x="54" y="51.5" text-anchor="middle" font-size="9.5" font-weight="600" fill={kleur.sub} letter-spacing="1">
          LOGO
        </text>
      </g>
    ) : soort === 'review' ? (
      <g fill={kleur.accent}>
        {sterX.map((x) => (
          <path
            transform={`translate(${x - 1} 40) scale(0.62)`}
            d="M12 1.6l3.1 6.4 7 1-5.1 5 1.2 7-6.2-3.3-6.2 3.3 1.2-7-5.1-5 7-1z"
          />
        ))}
      </g>
    ) : (
      <text x="32" y="53" font-size="11" font-weight="600" letter-spacing="2" fill={kleur.accent}>
        {soort === 'menu' ? 'MENU' : '@JOUWZAAK'}
      </text>
    )
  }

  <!-- tikzone rechtsboven -->
  <circle cx="186" cy="48" r="22" fill="none" stroke={kleur.accent} stroke-width="2" stroke-dasharray="3.5 4"></circle>
  <svg x="173" y="35" width="26" height="26" viewBox="57 -16 48 48" aria-hidden="true">
    <g fill="none" stroke={kleur.accent} stroke-width="7" stroke-linecap="round">
      <path d="M70.47 2.3A20 20 0 0 1 86.7 18.53"></path>
      <path d="M72.73-10.5A33 33 0 0 1 99.5 16.27"></path>
    </g>
    <circle cx="67" cy="22" r="8" fill={kleur.accent}></circle>
  </svg>

  <!-- kop -->
  <g font-weight="700" font-size={fs} letter-spacing={-0.02 * fs}>
    {
      regels.map((regel, i) => (
        <text x="30" y={eersteRegel + i * regelHoogte} fill={i === accentRegel ? kleur.accent : kleur.kop}>
          {regel}
        </text>
      ))
    }
  </g>
  <text x="31" y={subY} font-size="11.5" fill={kleur.sub}>{subtekst}</text>

  <!-- QR-code en tikhint -->
  <QrCode x={30} y={208} size={64} radius={8} color="#15172A" background="#FFFFFF" />
  {huisstijl && <rect x="30" y="208" width="64" height="64" rx="8" fill="none" stroke={kleur.rand} stroke-width="1.5" />}
  <g font-size="11" fill={kleur.sub}>
    <text x="108" y="234" font-weight="600" fill={kleur.kop}>Geen app</text>
    <text x="108" y="250">nodig</text>
  </g>

  <!-- voet -->
  <rect x="0" y="284" width="240" height="30" rx="9" fill={kleur.voet}></rect>
  <rect x="0" y="284" width="240" height="8" rx="4" fill={kleur.voetBoven}></rect>
</svg>

<style>
  .stand {
    width: 100%;
    height: auto;
    aspect-ratio: 240 / 330;
    overflow: visible;
  }
</style>
