---
import Icon from './Icon.astro';
import { branches } from '../data/branches';

interface Props {
  /** Huidige branche overslaan (op branchepagina's). */
  behalve?: string;
}

const { behalve } = Astro.props;
const lijst = branches.filter((b) => b.slug !== behalve);
---

<ul class="branche-cards" role="list">
  {
    lijst.map((b) => (
      <li class="branche-card">
        <span class="branche-card__icoon">
          <Icon name={b.icoon} size={26} />
        </span>
        <h3>
          <a href={`/${b.slug}`}>{b.naam}</a>
        </h3>
        <p>{b.teaser}</p>
        <span class="link-arrow" aria-hidden="true">
          Bekijk voor {b.meervoud}
          <Icon name="arrow-right" />
        </span>
      </li>
    ))
  }
</ul>

<style>
  .branche-cards {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 760px) {
    .branche-cards {
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    }
  }

  .branche-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    border-radius: var(--radius);
    background: var(--ink-2);
    border: 1px solid var(--ink-3);
    color: var(--white);
    transition: border-color 0.2s ease;
  }

  .branche-card:hover {
    border-color: var(--yellow);
  }

  .branche-card__icoon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--ink);
    margin-bottom: 0.5rem;
  }

  .branche-card h3 a {
    text-decoration: none;
  }

  .branche-card h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .branche-card h3 a:focus-visible {
    outline: none;
  }

  .branche-card:has(h3 a:focus-visible) {
    outline: 3px solid var(--yellow);
    outline-offset: 3px;
  }

  .branche-card p {
    color: var(--text-on-dark-muted);
    font-size: 0.9375rem;
  }

  .branche-card .link-arrow {
    margin-top: auto;
    align-self: flex-start;
    padding-top: 0.5rem;
  }
</style>
