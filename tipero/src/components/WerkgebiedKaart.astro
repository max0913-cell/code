---
/**
 * Schematisch kaartje van het werkgebied (niet op schaal).
 * Posities worden bij het bouwen berekend uit lat/lon in werkgebied.ts.
 */
import { plaatsen, rivieren } from '../data/werkgebied';

const breedte = 640;
const hoogte = 350;
const lonMin = 4.48;
const latMax = 52.02;
const schaal = 2415;
const cosLat = Math.cos((51.95 * Math.PI) / 180);

const xy = (lat: number, lon: number) => ({
  x: Math.round((lon - lonMin) * cosLat * schaal * 10) / 10,
  y: Math.round((latMax - lat) * schaal * 10) / 10,
});

// Vloeiende lijn door de punten (Catmull-Rom → Bézier).
function pad(punten: readonly (readonly [number, number])[]): string {
  const p = punten.map(([lat, lon]) => xy(lat, lon));
  let d = `M${p[0]!.x} ${p[0]!.y}`;
  for (let i = 0; i < p.length - 1; i++) {
    const p0 = p[i - 1] ?? p[i]!;
    const p1 = p[i]!;
    const p2 = p[i + 1]!;
    const p3 = p[i + 2] ?? p2;
    const c1 = { x: p1.x + (p2.x - p0.x) / 6, y: p1.y + (p2.y - p0.y) / 6 };
    const c2 = { x: p2.x - (p3.x - p1.x) / 6, y: p2.y - (p3.y - p1.y) / 6 };
    d += ` C${c1.x.toFixed(1)} ${c1.y.toFixed(1)} ${c2.x.toFixed(1)} ${c2.y.toFixed(1)} ${p2.x} ${p2.y}`;
  }
  return d;
}

// Labelpositie per plaats (zodat namen elkaar niet raken).
const labels: Record<string, { dx: number; dy: number; anchor: 'start' | 'middle' | 'end' }> = {
  Lekkerkerk: { dx: 12, dy: 5, anchor: 'start' },
  'Krimpen aan de Lek': { dx: -10, dy: 4, anchor: 'end' },
  'Krimpen aan den IJssel': { dx: -11, dy: -6, anchor: 'end' },
  'Ouderkerk aan den IJssel': { dx: 12, dy: 2, anchor: 'start' },
  Gouderak: { dx: 10, dy: 4, anchor: 'start' },
  Berkenwoude: { dx: 9, dy: 4, anchor: 'start' },
  Bergambacht: { dx: 0, dy: -11, anchor: 'middle' },
  Stolwijk: { dx: 9, dy: 4, anchor: 'start' },
  Haastrecht: { dx: 9, dy: 4, anchor: 'start' },
  Ammerstol: { dx: -4, dy: 18, anchor: 'middle' },
  Schoonhoven: { dx: 0, dy: -13, anchor: 'middle' },
  'Rotterdam-Oost': { dx: 0, dy: -13, anchor: 'middle' },
};

const korteNaam = (naam: string) => naam.replace('aan den', 'a/d').replace('aan de', 'a/d');
const punten = plaatsen.map((p) => ({ ...p, ...xy(p.lat, p.lon), label: labels[p.naam] ?? { dx: 9, dy: 4, anchor: 'start' as const } }));
const thuis = punten.find((p) => p.naam === 'Lekkerkerk');
const gebied = xy(51.957, 4.745);
const beschrijving = `Schematische kaart van het werkgebied van Tipero: ${plaatsen.map((p) => p.naam).join(', ')}.`;
---

<figure class="kaart">
  <svg viewBox={`0 0 ${breedte} ${hoogte}`} role="img" aria-label={beschrijving}>
    <text x={gebied.x} y={gebied.y} class="kaart__gebied" text-anchor="middle">KRIMPENERWAARD</text>
    {
      rivieren.map((r) => (
        <path d={pad(r.punten)} class="kaart__rivier" />
      ))
    }
    <text x="560" y="214" class="kaart__rivier-naam" text-anchor="middle" transform="rotate(32 560 214)">Lek</text>
    <text x="262" y="128" class="kaart__rivier-naam" text-anchor="middle" transform="rotate(62 262 128)">Hollandse IJssel</text>
    <text x="70" y="294" class="kaart__rivier-naam" text-anchor="middle">Nieuwe Maas</text>

    {thuis && <circle cx={thuis.x} cy={thuis.y} r="16" class="kaart__thuis" />}
    {
      punten.map((p) => (
        <g class:list={['kaart__plaats', { 'kaart__plaats--uitgelicht': p.uitgelicht }]}>
          <circle cx={p.x} cy={p.y} r={p.uitgelicht ? 6 : 4.5} />
          <text x={p.x + p.label.dx} y={p.y + p.label.dy} text-anchor={p.label.anchor}>
            {korteNaam(p.naam)}
          </text>
        </g>
      ))
    }
  </svg>
  <figcaption>Schematische kaart, niet op schaal.</figcaption>
</figure>

<style>
  .kaart svg {
    width: 100%;
    height: auto;
    aspect-ratio: 640 / 350;
    overflow: visible;
  }

  .kaart figcaption {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--text-on-dark-muted);
    text-align: right;
  }

  .kaart__gebied {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.35em;
    fill: #3a3f60;
  }

  .kaart__rivier {
    fill: none;
    stroke: #2a2e4a;
    stroke-width: 7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .kaart__rivier-naam {
    font-size: 10px;
    font-style: italic;
    fill: #8a8eaa;
  }

  .kaart__thuis {
    fill: rgb(255 198 26 / 0.18);
    stroke: rgb(255 198 26 / 0.6);
    stroke-width: 1.5;
  }

  .kaart__plaats circle {
    fill: #ffc61a;
    stroke: #15172a;
    stroke-width: 2;
  }

  .kaart__plaats text {
    font-size: 11px;
    fill: #b8bbd0;
    paint-order: stroke;
    stroke: #15172a;
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  .kaart__plaats--uitgelicht text {
    font-size: 13.5px;
    font-weight: 600;
    fill: #ffffff;
  }

  /* Op kleine schermen: alleen de belangrijkste plaatsnamen, wat groter. */
  @media (max-width: 599.98px) {
    .kaart__plaats:not(.kaart__plaats--uitgelicht) text,
    .kaart__rivier-naam {
      display: none;
    }

    .kaart__plaats--uitgelicht text {
      font-size: 17px;
    }

    .kaart__gebied {
      font-size: 17px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .kaart__thuis {
      transform-box: fill-box;
      transform-origin: center;
      animation: thuis 3s ease-in-out infinite;
    }
  }

  @keyframes thuis {
    0%,
    100% {
      transform: scale(0.85);
      opacity: 1;
    }
    50% {
      transform: scale(1.25);
      opacity: 0.55;
    }
  }
</style>
