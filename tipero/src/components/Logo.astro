---
/**
 * Het Tipero-logo (exacte SVG). `variant="donker"` voor lichte
 * achtergronden, `variant="wit"` voor donkere achtergronden.
 */
interface Props {
  variant?: 'donker' | 'wit';
  class?: string;
  /** Toegankelijke naam. Leeg laten als de omringende link al een naam heeft. */
  label?: string;
}

const { variant = 'donker', class: className, label = 'Tipero' } = Astro.props;
const letterKleur = variant === 'wit' ? '#FFFFFF' : '#15172A';
---

<svg
  class:list={['logo', className]}
  viewBox="-4 -18 352 146"
  xmlns="http://www.w3.org/2000/svg"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <g stroke={letterKleur} stroke-width="14">
    <path d="M7 47H39"></path>
    <path d="M19 24V77A16 16 0 0 0 35 93H41"></path>
    <path d="M67 47V93"></path>
    <path d="M93 47V117"></path>
    <circle cx="116" cy="70" r="23"></circle>
    <path d="M165 70H211A23 23 0 1 0 201.19 88.84"></path>
    <path d="M237 93V70A23 23 0 0 1 260 47H264"></path>
    <circle cx="311" cy="70" r="23"></circle>
  </g>
  <g stroke="#FFC61A" stroke-width="7">
    <path d="M70.47 2.3A20 20 0 0 1 86.7 18.53"></path>
    <path d="M72.73-10.5A33 33 0 0 1 99.5 16.27"></path>
  </g>
  <circle cx="67" cy="22" r="8" fill="#FFC61A"></circle>
</svg>

<style>
  .logo {
    height: auto;
    aspect-ratio: 352 / 146;
  }
</style>
